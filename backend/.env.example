PORT=3000
HOST=0.0.0.0
# Production DB_PATH must point to persistent disk, e.g. /var/data/database.sqlite
DB_PATH=./data/database.sqlite
ADMIN_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://uniquenetworkbd.github.io,http://localhost:3000,http://127.0.0.1:3000
# Set only behind one trusted reverse proxy.
TRUST_PROXY=1
NODE_ENV=production

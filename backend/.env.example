# Local development defaults. Set production values in the hosting provider's secret/environment UI.
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/database.sqlite
CORS_ORIGINS=https://uniquenetworkbd.github.io,http://localhost:3000,http://127.0.0.1:3000
# Keep 0 unless your hosting platform's proxy topology is confirmed and configured.
TRUST_PROXY=0
NODE_ENV=development

# First-admin bootstrap only: export these in the shell when running npm run seed:admin.
# Do not commit real values or keep the initial password in production environment settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-bytes

# Optional allowlisted TCP probes. Empty array keeps network status in demo mode.
# Each target: {"id":"core-router","label":"Core Router","host":"192.0.2.1","port":8729,"type":"mikrotik"}
NETWORK_TARGETS_JSON=[]

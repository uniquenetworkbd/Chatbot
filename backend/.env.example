# Local development only. Never commit real credentials.
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/database.sqlite
BACKUP_DIR=./data/backups
CORS_ORIGINS=https://uniquenetworkbd.github.io,http://localhost:3000,http://127.0.0.1:3000
# Keep 0 unless the exact trusted proxy topology is confirmed.
TRUST_PROXY=0
NODE_ENV=development
# Fixed administrator username: Raive (defined in backend code, not a secret).
# Supply only this password through the backend runtime secret store.
ADMIN_PASSWORD=

{
  "name": "Unique Network BD Chatbot Backend",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Chatbot API",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "cd backend && npm install",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "customizations": {
    "codespaces": {
      "repositories": {
        "uniquenetworkbd/Chatbot": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    }
  }
}
